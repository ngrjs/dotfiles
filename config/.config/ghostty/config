# Font
font-family = FiraCode Nerd Font
font-size = 12

# Window
window-decoration = false
gtk-titlebar = false
gtk-single-instance = true
window-padding-x = 12
window-padding-y = 12
background-opacity = 1.0
background-blur-radius = 32

# Cursor
cursor-style = block
cursor-style-blink = true

# Behavior
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false
app-notifications = false

# Shell integration (no-cursor keeps the block cursor set above)
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor

# Splits
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Keybinds
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
keybind = shift+enter=text:\n

# Splits / tabs, tmux-style (leader: Ctrl+s)
keybind = ctrl+s>shift+backslash=new_split:right
keybind = ctrl+s>minus=new_split:down
keybind = ctrl+s>h=goto_split:left
keybind = ctrl+s>j=goto_split:down
keybind = ctrl+s>k=goto_split:up
keybind = ctrl+s>l=goto_split:right
keybind = ctrl+s>z=toggle_split_zoom
keybind = ctrl+s>x=close_surface
keybind = ctrl+s>c=new_tab
keybind = ctrl+s>n=next_tab
keybind = ctrl+s>p=previous_tab

# Colors are generated by DankMaterialShell from the wallpaper (themes/dankcolors)
theme = dankcolors
